{
  "name": "mcp-client-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local MCP stdio bridge to ServiceNow MCP over HTTP with OAuth client credentials",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test:smoke": "tsx src/smoke.ts",
    "prompt": "tsx src/promptRouter.ts",
    "prompt:verbose": "cross-env PROMPT_VERBOSE=1 tsx src/promptRouter.ts"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "pino": "^9.5.0",
    "undici": "^7.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}