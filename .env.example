SN_INSTANCE_URL=https://your-instance.service-now.com
SN_MCP_URL=https://your-instance.service-now.com/sncapps/mcp-server/mcp/sn_mcp_server_default
SN_OAUTH_TOKEN_URL=https://your-instance.service-now.com/oauth_token.do
SN_CLIENT_ID=your_client_id
SN_CLIENT_SECRET=your_client_secret
# Optional
SN_OAUTH_SCOPE=
SN_AUTH_MODE=oauth
SN_BASIC_USERNAME=
SN_BASIC_PASSWORD=

# Optional logging level: trace|debug|info|warn|error|fatal
LOG_LEVEL=info

# Optional outbound proxy settings (if required by your network)
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=localhost,127.0.0.1

# Prompt-mode optional settings
MCPORTER_CALL_TIMEOUT=180000
PROMPT_VERBOSE=0